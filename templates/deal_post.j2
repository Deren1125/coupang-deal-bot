{% if facts.ship %}{% set _ = info.append("🚚 " ~ facts.ship) %}{% endif %}
{% if product.rating %}{% set _ = info.append("⭐ " ~ product.rating ~ ((" (" ~ "{:,}".format(product.review_count) ~ ")") if product.review_count else "")) %}{% endif %}
