{#
  채널 발행 메시지 (텔레그램 HTML) — 블로그 주인이 고른 A 정보 항목형 (토스 역대딜방 양식, 2026-10).
  1줄 = 알림 미리보기: 등급 + 가격 + 근거 하나 (그대로). 2줄 = 짧은 광고 표시 '광고 · 쿠팡 파트너스 수수료' (주인 결정 10/15,
  공정위 추천·보증 심사지침 2024-12-01: 글은 첫 부분에 — 몰마다 같은 말, 고지가 없는 글(수수료 없음)은 이 줄도 없음).
  3줄 = 상품명(굵게). 그 아래 '항목 : 값' 줄 → 링크 → 전체 제휴 고지(끝, 그대로).
  숫자는 데이터(facts)에서만. 모르는 칸은 줄째로 뺀다 (지어내지 않음). 방장 한줄평은 AI 한마디, 없으면 상품 그룹별 고정 한 줄.
  가격 없는 쿠폰·이벤트는 1줄 = 🎟/🎁 + 이름, 링크 문구도 '쿠폰 받으러 가기' / '이벤트 보러 가기'.
  ⚠️ 한 줄을 통째로 차지하는 {% if %} / {% endif %} 줄은 출력에서 사라집니다. 줄 "안"의 조건은 {% endif +%} 로 닫아야 줄바꿈이 유지됩니다.
#}
{% if product.has_price %}
{{ facts.badge }} <b>{{ product.price | won }}</b>{% if facts.evidence_short %} · {{ facts.evidence_short }}{% endif +%}
{% if shop.ad_line %}
{{ shop.ad_line }}
{% endif %}
<b>{{ pname }}</b>
{% else %}
{{ facts.badge }} <b>{{ pname }}</b>
{% if shop.ad_line %}
{{ shop.ad_line }}
{% endif %}
{% endif %}
{% if product.headline %}
[{{ product.headline }}]
{% endif %}
{% set rows = [] %}
{% if product.has_price and facts.option %}{% set _ = rows.append("구매옵션 : " ~ facts.option) %}{% endif %}
{% if facts.cat %}{% set _ = rows.append("카테고리 : " ~ facts.cat) %}{% endif %}
{% if facts.kind_labels %}{% set _ = rows.append("할인분류 : " ~ (facts.kind_labels | join(" · "))) %}{% endif %}
{% if facts.low_label and facts.low_label != facts.evidence_short %}{% set _ = rows.append("가격기록 : " ~ facts.low_label) %}{% endif %}
{% if product.has_price and facts.compare %}{% set _ = rows.append("가격비교 : " ~ facts.compare) %}{% endif %}
{% if facts.unit_each %}{% set _ = rows.append("단위가격 : " ~ facts.unit_each) %}{% endif %}
{% if facts.list_pct %}{% set _ = rows.append("정가대비 : " ~ facts.list_pct ~ "%↓") %}{% endif %}
{% if facts.ship %}{% set _ = rows.append("배송관련 : " ~ facts.ship) %}{% endif %}
{% if facts.genuine %}{% set _ = rows.append("판매처 : " ~ facts.genuine) %}{% endif %}
{% if product.rating %}{% set _ = rows.append("평점점수 : " ~ product.rating) %}{% endif %}
{% if product.review_count %}{% set _ = rows.append("리뷰숫자 : " ~ "{:,}".format(product.review_count)) %}{% endif %}
{% if facts.rank_label %}{% set _ = rows.append("순위형성 : " ~ facts.rank_label) %}{% endif %}
{% set _ = rows.append("방장 한줄평 : " ~ facts.one_liner) %}

{{ rows | join("\n") }}

👉 <a href="{{ link }}">{{ facts.link_label }}</a>
{% if shop.disclosure %}

<i>{{ shop.disclosure }}</i>
{% endif %}
