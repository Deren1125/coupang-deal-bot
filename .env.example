# ─── 쿠팡파트너스 Open API (docs/SETUP_KEYS.md 참고) ───────────────────────
COUPANG_ACCESS_KEY=
COUPANG_SECRET_KEY=
# 채널 구분용 subId (선택)
COUPANG_SUB_ID=

# ─── 링크프라이스 (11번가/G마켓/옥션/SSG/롯데온/알리 등 딥링크 자동 변환, 선택) ──
LINKPRICE_AFFILIATE_ID=

# ─── 애드픽 쇼핑메이트 핫딜 API (선택) ──────────────────────────────────
ADPICK_AFFID=

# ─── 텔레그램 ────────────────────────────────────────────────────────────
# @BotFather 에서 발급받은 봇 토큰
TELEGRAM_BOT_TOKEN=
# 핫딜을 올릴 채널. 공개 채널이면 @채널아이디, 비공개 채널이면 -100으로 시작하는 숫자 ID
TELEGRAM_CHANNEL_ID=@hot_deal_and_info
# 상태 보고/수동 링크 입력을 주고받을 내 개인 챗 ID (숫자). `dealbot chat-id` 로 확인
TELEGRAM_ADMIN_CHAT_ID=

# ─── 앱 동작 (선택) ──────────────────────────────────────────────────────
DEALBOT_CONFIG=config.yaml
DEALBOT_DATA_DIR=./data
DEALBOT_DRY_RUN=false
LOG_LEVEL=INFO
TZ=Asia/Seoul

# ─── 스레드(Threads) 자동 발행 (선택) ────────────────────────────────────
# developers.facebook.com 에서 앱 생성 → Threads API 사용 사례 추가 후 앱 ID/시크릿
THREADS_APP_ID=
THREADS_APP_SECRET=
# 앱 설정의 리디렉션 URI 와 똑같이 (기본값 그대로 두어도 됨)
THREADS_REDIRECT_URI=https://localhost/callback

# ─── 휴대폰 푸시 알림 (선택, 텔레그램과 별개) ─────────────────────────────
# ntfy (무료): 폰에 ntfy 앱 설치 → 아무도 못 맞출 긴 토픽 이름으로 구독 → 그 이름을 여기에
NTFY_TOPIC=
# ntfy 셀프호스팅/유료 계정이면 토큰 (선택)
NTFY_TOKEN=
# Pushover (유료, 1회 결제): https://pushover.net 에서 User Key + Application Token
PUSHOVER_USER_KEY=
PUSHOVER_APP_TOKEN=
