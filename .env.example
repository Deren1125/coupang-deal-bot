# ─── 쿠팡파트너스 Open API (docs/SETUP_KEYS.md 참고) ───────────────────────
COUPANG_ACCESS_KEY=
COUPANG_SECRET_KEY=
# 채널 구분용 subId (선택). 파트너스 대시보드에서 채널별 성과를 나눠 보고 싶을 때 사용
COUPANG_SUB_ID=

# ─── 텔레그램 ────────────────────────────────────────────────────────────
# @BotFather 에서 발급받은 봇 토큰
TELEGRAM_BOT_TOKEN=
# 핫딜을 올릴 채널. 공개 채널이면 @채널아이디, 비공개 채널이면 -100으로 시작하는 숫자 ID
TELEGRAM_CHANNEL_ID=
# 상태 보고를 받을 내 개인 챗 ID (숫자). `dealbot chat-id` 명령으로 확인 가능
TELEGRAM_ADMIN_CHAT_ID=

# ─── 앱 동작 (선택) ──────────────────────────────────────────────────────
# 설정 파일 경로 (기본 ./config.yaml)
DEALBOT_CONFIG=config.yaml
# SQLite DB / 로그 저장 위치 (Docker에서는 /data 로 마운트)
DEALBOT_DATA_DIR=./data
# 실제 발행 없이 로그만 남기려면 true
DEALBOT_DRY_RUN=false
LOG_LEVEL=INFO
TZ=Asia/Seoul
